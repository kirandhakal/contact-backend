{
  "name": "contact-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed:admin": "tsx src/db/seed-admin.ts",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:migrate": "docker compose --env-file .env.docker run --rm app node dist/db/migrate.js",
    "docker:logs": "docker compose --env-file .env.docker logs -f app worker",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:local": "bash scripts/docker-local.sh",
    "register:form": "node scripts/register-form.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "nodemailer": "^10.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
