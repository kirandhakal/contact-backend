NODE_ENV=production
HOST=0.0.0.0
PORT=3100
APP_PORT=3100
DATABASE_URL=postgres://forms:forms@postgres:5432/forms
ADMIN_API_KEY=replace-with-at-least-24-random-characters
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
PUBLIC_BASE_URL=http://localhost:3100
MAX_BODY_BYTES=65536
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=20
RETENTION_DAYS=90
WORKER_POLL_MS=1000
SMTP_URL=
SMTP_TIMEOUT_MS=30000
EMAIL_FROM=forms@example.com
WEBHOOK_TIMEOUT_MS=5000
TURNSTILE_SECRET_KEY=
AUTH_MIN_RESPONSE_MS=150
TRUST_PROXY=false
OTP_HMAC_KEY=
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
AUTH_RESET_TOKEN_TTL_SECONDS=600

# Mail configuration (compact)
# Quote MAIL_PASSWORD if it contains spaces; Docker env files truncate unquoted values at whitespace.
MAIL_HOST=smtp.gmail.com
MAIL_AUTH=true
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
ENABLE_EMAIL=true
ENABLE_MAIL=true
